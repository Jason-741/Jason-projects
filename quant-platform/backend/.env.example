# Copy to backend/.env and fill in. Never commit .env.
APP_SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./quant.db
# DATABASE_URL=postgresql+psycopg://quant:quant@localhost:5432/quant
CORS_ORIGINS=http://localhost:3000
ALLOW_REGISTRATION=false           # set true only for the first run, then false
BASE_CURRENCY=CAD

# Data providers (all optional; missing ones are reported as "not configured")
SEC_USER_AGENT="Your Name your.email@example.com"   # required by SEC fair-access policy
FRED_API_KEY=
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Research assistant (optional)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
